{
  "id": "B",
  "dir": "1 Basic",
  "name": "Basic",
  "index": "B00 Basic.md",
  "lessons": [
    {
      "id": "B01",
      "title": "Write in 30 seconds",
      "file": "B01 Write in 30 seconds.md",
      "steps": [
        {
          "text": "Press i and type: Today I start my travel journal",
          "ids": ["VIM-02"],
          "check": { "kind": "text", "pred": "line-contains", "args": ["Today I start my travel journal"] }
        },
        {
          "text": "Press Esc: you leave INSERT and the cursor steps back",
          "hint": "Esc is at the top left of the keyboard",
          "ids": ["VIM-08", "VIM-01"],
          "check": { "kind": "action", "event": "mode_changed", "value": "normal" }
        },
        {
          "text": "Save the note with ctrl+s",
          "hint": "ctrl+s is the save key",
          "ids": ["EDT-02"],
          "check": { "kind": "disk", "pred": "file-changed", "args": [] }
        },
        {
          "text": "Open a blank note with space n",
          "hint": "space n opens a new tab",
          "ids": ["EDT-01"],
          "check": { "kind": "action", "event": "new_draft" }
        }
      ]
    },
    {
      "id": "B02",
      "title": "Insert anywhere",
      "file": "B02 Insert anywhere.md",
      "steps": [
        {
          "text": "With the cursor on the t of cat, press a and type s",
          "hint": "a inserts after the cursor",
          "ids": ["VIM-03"],
          "check": { "kind": "text", "pred": "line-contains", "args": ["cats"] }
        },
        {
          "text": "Press A and type · suitcase",
          "hint": "A goes to the end of the line",
          "ids": ["VIM-04"],
          "check": { "kind": "text", "pred": "line-ends", "args": [" · suitcase"] }
        },
        {
          "text": "Press I and type 01 ·",
          "hint": "I goes to the start of the line",
          "ids": ["VIM-05"],
          "check": { "kind": "text", "pred": "line-starts", "args": ["01 · "] }
        },
        {
          "text": "Press o and type packing list below",
          "hint": "o opens a line below",
          "ids": ["VIM-06"],
          "check": { "kind": "text", "pred": "line-contains", "args": ["packing list"] }
        },
        {
          "text": "Press O and type — flight — above",
          "hint": "O opens a line above",
          "ids": ["VIM-07"],
          "check": { "kind": "text", "pred": "line-contains", "args": ["— flight —"] }
        }
      ]
    },
    {
      "id": "B03",
      "title": "Delete without fear",
      "file": "B03 Delete without fear.md",
      "steps": [
        {
          "text": "Put the cursor on the second t of hottel and press x",
          "hint": "x deletes the letter under the cursor",
          "ids": ["VIM-15"],
          "check": { "kind": "text", "pred": "line-equals", "args": ["hotel"] }
        },
        {
          "text": "Put the cursor on draft and press dd",
          "hint": "dd deletes the whole line",
          "ids": ["VIM-16"],
          "check": {
            "kind": "all",
            "checks": [
              { "kind": "text", "pred": "absent", "args": ["draft"] },
              { "kind": "text", "pred": "line-equals", "args": ["hotel"] }
            ]
          }
        }
      ]
    },
    {
      "id": "B04",
      "title": "Move without a mouse",
      "file": "B04 Move without a mouse.md",
      "steps": [
        {
          "text": "Move around the list with h j k l",
          "ids": ["VIM-09"],
          "check": { "kind": "action", "event": "motion", "value": "hjkl" }
        },
        {
          "text": "Do the same walk with the arrow keys",
          "ids": ["VIM-10"],
          "check": { "kind": "action", "event": "motion", "value": "arrows" }
        },
        {
          "text": "Jump with 0 ^ Home $ End within a line",
          "ids": ["VIM-12"],
          "check": { "kind": "action", "event": "motion", "value": "line-bounds" }
        },
        {
          "text": "Jump to the start and the end with gg and G",
          "ids": ["VIM-13"],
          "check": { "kind": "action", "event": "motion", "value": "file-bounds" }
        }
      ]
    },
    {
      "id": "B05",
      "title": "Undo and redo",
      "file": "B05 Undo and redo.md",
      "steps": [
        {
          "text": "Delete the line delete me with dd, then press u",
          "hint": "u undoes the last change",
          "ids": ["VIM-23"],
          "check": { "kind": "text", "pred": "absent", "args": ["delete me"] }
        },
        {
          "text": "Type oops, Esc, u, then ctrl+r: oops comes back",
          "hint": "ctrl+r redoes what u undid",
          "ids": ["VIM-24"],
          "check": { "kind": "text", "pred": "line-contains", "args": ["oops"] }
        }
      ]
    },
    {
      "id": "B06",
      "title": "Save with a name and close",
      "file": "B06 Save with a name and close.md",
      "steps": [
        {
          "text": "Press : and run w travel-list",
          "hint": "type :w travel-list and Enter",
          "ids": ["EDT-03"],
          "check": { "kind": "disk", "pred": "exists", "args": ["travel-list"] }
        },
        {
          "text": "Open a note with space n and save: look at the folders",
          "hint": "the dialog suggests folders as you type",
          "ids": ["EDT-04", "NOTE-23"],
          "check": { "kind": "action", "event": "save_dialog" }
        },
        {
          "text": "Close the tab with space x",
          "hint": "space x closes the current tab",
          "ids": ["EDT-05"],
          "check": { "kind": "action", "event": "tab_closed" }
        }
      ]
    },
    {
      "id": "B07",
      "title": "Tabs",
      "file": "B07 Tabs.md",
      "steps": [
        {
          "text": "With two notes, go forward with L and back with H",
          "hint": "with the preview focused, H and L move the calendar",
          "ids": ["NEW-02"],
          "check": {
            "kind": "all",
            "checks": [
              { "kind": "action", "event": "next_tab" },
              { "kind": "action", "event": "prev_tab" }
            ]
          }
        },
        {
          "text": "Also try ] [ space tab and space shift+tab",
          "hint": "] and [ switch tabs",
          "ids": ["NOTE-11"],
          "check": { "kind": "action", "event": "next_tab", "value": "]" }
        },
        {
          "text": "Click a tab, close it and make another with +",
          "hint": "the + is to the right of the tabs",
          "ids": ["NOTE-12"],
          "check": {
            "kind": "all",
            "checks": [
              { "kind": "action", "event": "tab_closed" },
              { "kind": "action", "event": "new_draft" }
            ]
          }
        }
      ]
    },
    {
      "id": "B08",
      "title": "The explorer and focus",
      "file": "B08 The explorer and focus.md",
      "steps": [
        {
          "text": "Press space e twice: it opens and closes the explorer",
          "hint": "the second time closes it and the editor comes back",
          "ids": ["NEW-01"],
          "check": { "kind": "action", "event": "focus_explorer" }
        },
        {
          "text": "Narrow the window and close the explorer with Esc",
          "hint": "in a narrow window the explorer covers the editor",
          "ids": ["NOTE-15"],
          "check": { "kind": "action", "event": "focus_explorer", "value": "overlay" }
        },
        {
          "text": "Look at the three areas: explorer, editor and preview",
          "ids": ["VIEW-01"],
          "check": { "kind": "action", "event": "split_view" }
        },
        {
          "text": "Drag the divider between editor and preview",
          "ids": ["NOTE-14"],
          "check": { "kind": "action", "event": "pane_resized" }
        },
        {
          "text": "Move the focus with tab, shift+tab, ctrl+h and ctrl+l",
          "hint": "tab goes through the panes in order",
          "ids": ["NOTE-13"],
          "check": { "kind": "action", "event": "focus_cycle" }
        }
      ]
    },
    {
      "id": "B09",
      "title": "Open and create notes",
      "file": "B09 Open and create notes.md",
