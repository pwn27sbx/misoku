  "lessons": [
    {
      "id": "B01",
      "title": "Escribe en 30 segundos",
      "file": "B01 Escribe en 30 segundos.md",
      "steps": [
        {
          "text": "Pulsa i y escribe: Hoy empiezo mi diario de viaje",
          "ids": ["VIM-02"],
          "check": { "kind": "text", "pred": "line-contains", "args": ["Hoy empiezo mi diario de viaje"] }
        },
        {
          "text": "Pulsa Esc: sales de INSERT y el cursor retrocede",
          "hint": "Esc está arriba a la izquierda",
          "ids": ["VIM-08", "VIM-01"],
          "check": { "kind": "action", "event": "mode_changed", "value": "normal" }
        },
        {
          "text": "Guarda la nota con ctrl+s",
          "hint": "ctrl+s es la tecla de guardar",
          "ids": ["EDT-02"],
          "check": { "kind": "disk", "pred": "file-changed", "args": [] }
        },
        {
          "text": "Abre una nota en blanco con space n",
          "hint": "space n abre pestaña nueva",
          "ids": ["EDT-01"],
          "check": { "kind": "action", "event": "new_draft" }
        }
      ]
    },
    {
      "id": "B02",
      "title": "Insertar donde quieras",
      "file": "B02 Insertar donde quieras.md",
      "steps": [
        {
          "text": "Con el cursor en la o de gato, pulsa a y escribe s",
          "hint": "a inserta después del cursor",
          "ids": ["VIM-03"],
          "check": { "kind": "text", "pred": "line-contains", "args": ["gatos"] }
        },
        {
          "text": "Pulsa A y escribe · maleta",
          "hint": "A va al final de la línea",
          "ids": ["VIM-04"],
          "check": { "kind": "text", "pred": "line-ends", "args": [" · maleta"] }
        },
        {
          "text": "Pulsa I y escribe 01 ·",
          "hint": "I va al principio de la línea",
          "ids": ["VIM-05"],
          "check": { "kind": "text", "pred": "line-starts", "args": ["01 · "] }
        },
        {
          "text": "Pulsa o y escribe lista de equipaje abajo",
          "hint": "o abre una línea debajo",
          "ids": ["VIM-06"],
          "check": { "kind": "text", "pred": "line-contains", "args": ["lista de equipaje"] }
        },
        {
          "text": "Pulsa O y escribe — vuelo — arriba",
          "hint": "O abre una línea encima",
          "ids": ["VIM-07"],
          "check": { "kind": "text", "pred": "line-contains", "args": ["— vuelo —"] }
        }
      ]
    },
    {
      "id": "B03",
      "title": "Borrar sin miedo",
      "file": "B03 Borrar sin miedo.md",
      "steps": [
        {
          "text": "Pon el cursor en la e de hospedaje y pulsa x",
          "hint": "x borra la letra del cursor",
          "ids": ["VIM-15"],
          "check": { "kind": "text", "pred": "line-equals", "args": ["hospdaje"] }
        },
        {
          "text": "Pon el cursor en borrador y pulsa dd",
          "hint": "dd borra la línea entera",
          "ids": ["VIM-16"],
          "check": {
            "kind": "all",
            "checks": [
              { "kind": "text", "pred": "absent", "args": ["borrador"] },
              { "kind": "text", "pred": "line-equals", "args": ["hospdaje"] }
            ]
          }
        }
      ]
    },
    {
      "id": "B04",
      "title": "Moverte sin ratón",
      "file": "B04 Moverte sin ratón.md",
      "steps": [
        {
          "text": "Muévete por la lista con h j k l",
          "ids": ["VIM-09"],
          "check": { "kind": "action", "event": "motion", "value": "hjkl" }
        },
        {
          "text": "Repite el recorrido con las flechas",
          "ids": ["VIM-10"],
          "check": { "kind": "action", "event": "motion", "value": "arrows" }
        },
        {
          "text": "Salta con 0 ^ Home $ End de una línea",
          "ids": ["VIM-12"],
          "check": { "kind": "action", "event": "motion", "value": "line-bounds" }
        },
        {
          "text": "Salta al principio y al final con gg y G",
          "ids": ["VIM-13"],
          "check": { "kind": "action", "event": "motion", "value": "file-bounds" }
        }
      ]
    },
    {
      "id": "B05",
      "title": "Deshacer y rehacer",
      "file": "B05 Deshacer y rehacer.md",
      "steps": [
        {
          "text": "Escribe prueba, sal con Esc y pulsa u",
          "hint": "u deshace el último cambio",
          "ids": ["VIM-23"],
          "check": { "kind": "text", "pred": "absent", "args": ["prueba"] }
        },
        {
          "text": "Pulsa ctrl+r y recupera la línea",
          "hint": "ctrl+r rehace",
          "ids": ["VIM-24"],
          "check": { "kind": "text", "pred": "line-contains", "args": ["prueba"] }
        }
      ]
    },
    {
      "id": "B06",
      "title": "Guardar con nombre y cerrar",
      "file": "B06 Guardar con nombre y cerrar.md",
      "steps": [
        {
          "text": "Pulsa : y ejecuta w lista-viaje",
          "hint": "escribe :w lista-viaje y Enter",
          "ids": ["EDT-03"],
          "check": { "kind": "disk", "pred": "exists", "args": ["lista-viaje"] }
        },
        {
          "text": "Abre una nota con space n y guarda: mira las carpetas",
          "hint": "el diálogo sugiere carpetas mientras escribes",
          "ids": ["EDT-04", "NOTE-23"],
          "check": { "kind": "action", "event": "save_dialog" }
        },
        {
          "text": "Cierra la pestaña con space x",
          "hint": "space x cierra la pestaña actual",
          "ids": ["EDT-05"],
          "check": { "kind": "action", "event": "tab_closed" }
        }
      ]
    },
    {
      "id": "B07",
      "title": "Pestañas",
      "file": "B07 Pestañas.md",
      "steps": [
        {
          "text": "Con dos notas, pasa con L y vuelve con H",
          "hint": "con el preview enfocado H y L son del calendario",
          "ids": ["NEW-02"],
          "check": {
            "kind": "all",
            "checks": [
              { "kind": "action", "event": "next_tab" },
              { "kind": "action", "event": "prev_tab" }
            ]
          }
        },
        {
          "text": "Prueba también ] [ space tab y space shift+tab",
          "hint": "] y [ cambian de pestaña",
          "ids": ["NOTE-11"],
          "check": { "kind": "action", "event": "next_tab", "value": "]" }
        },
        {
          "text": "Haz clic en una pestaña, ciérrala y crea otra con +",
          "hint": "el + está a la derecha de las pestañas",
          "ids": ["NOTE-12"],
          "check": {
            "kind": "all",
            "checks": [
              { "kind": "action", "event": "tab_closed" },
              { "kind": "action", "event": "new_draft" }
            ]
          }
        }
      ]
    },
    {
      "id": "B08",
      "title": "El explorador y el foco",
      "file": "B08 El explorador y el foco.md",
      "steps": [
        {
          "text": "Pulsa space e dos veces: abre y cierra el explorador",
          "hint": "la segunda vez lo cierra y vuelve el editor",
          "ids": ["NEW-01"],
          "check": { "kind": "action", "event": "focus_explorer" }
        },
        {
          "text": "Estrecha la ventana y cierra el explorador con Esc",
          "hint": "en ventana estrecha el explorador se superpone",
          "ids": ["NOTE-15"],
          "check": { "kind": "action", "event": "focus_explorer", "value": "overlay" }
        },
        {
          "text": "Mira las tres zonas: explorador, editor y preview",
          "ids": ["VIEW-01"],
          "check": { "kind": "action", "event": "split_view" }
        },
        {
          "text": "Arrastra el divisor entre editor y preview",
          "ids": ["NOTE-14"],
          "check": { "kind": "action", "event": "pane_resized" }
        },
        {
          "text": "Cambia el foco con tab, shift+tab, ctrl+h y ctrl+l",
          "hint": "tab recorre los paneles en orden",
          "ids": ["NOTE-13"],
          "check": { "kind": "action", "event": "focus_cycle" }
        }
      ]
    },
